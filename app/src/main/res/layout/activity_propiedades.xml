<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- =============================== -->
        <!-- ENCABEZADO -->
        <!-- =============================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="@color/inmosmart_blue"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="InmoSmart"
                android:textColor="@color/white"
                android:textSize="25sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- =============================== -->
        <!-- CONTENIDO PRINCIPAL -->
        <!-- =============================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="25dp"
            android:paddingTop="30dp"
            android:paddingEnd="25dp"
            android:paddingBottom="30dp">

            <!-- TITULO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Todas las propiedades"
                android:textColor="@color/text_dark"
                android:textSize="26sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <!-- FILTRO TIPO DE OPERACION -->
            <Spinner
                android:id="@+id/spinnerTipo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="@color/border_gray"
                android:popupBackground="@color/white"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <!-- FILTRO LOCALIDAD / CIUDAD -->
            <EditText
                android:id="@+id/etCiudad"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Ciudad (ej. Córdoba)"
                android:textColor="@color/text_dark"
                android:textColorHint="#757575"
                android:inputType="text"
                android:paddingStart="14dp"
                android:textSize="15sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <!-- FILTRO PRECIO -->
            <EditText
                android:id="@+id/editPrecio"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Precio Máximo ($)"
                android:textColor="@color/text_dark"
                android:textColorHint="#757575"
                android:inputType="numberDecimal"
                android:paddingStart="14dp"
                android:textSize="15sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <!-- BOTÓN DE BÚSQUEDA -->
            <Button
                android:id="@+id/btnBuscar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="@color/inmosmart_blue"
                android:text="Buscar Inmuebles"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <!-- MENSAJE DE SIN RESULTADOS (Criterio de Aceptación) -->
            <TextView
                android:id="@+id/tvSinResultados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="20dp"
                android:text="No se encontraron inmuebles con los criterios seleccionados"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="italic"
                android:visibility="gone" />

            <!-- LISTA DE INMUEBLES -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvInmuebles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="true" />

        </LinearLayout>

        <!-- SECCIÓN 3: Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/footer_blue"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_home_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="INMOSMART"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:text="Conectamos personas con su próximo hogar."
                android:textColor="@color/footer_texto"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONTACTO"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:lineSpacingMultiplier="1.3"
                android:text="Córdoba, Argentina\ninfo@inmosmart.com"
                android:textColor="@color/footer_texto"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEscribinos"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Escribinos"
                android:textAllCaps="false"
                android:textColor="@color/footer_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/white"
                app:cornerRadius="26dp"
                app:icon="@drawable/contact_support"
                app:iconGravity="textStart"
                app:iconTint="@color/footer_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:text="Copyright 2026 InmoSmart - Todos los derechos reservados"
                android:textColor="@color/footer_texto_claro"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>